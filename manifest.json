{
  "manifest_version": 3,
  "name": "GraphQL Inspector",
  "version": "1.0.0",
  "description": "Inspect GraphQL queries and mutations in your network requests",
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "tabs"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; style-src 'self'; object-src 'none'; base-uri 'none';"
  }
}
